# ============================================================
# SIH 26131 Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- Gemini AI Chat ---
# Required for the /chat agricultural assistant endpoint.
# Obtain API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Weather API ---
# Open-Meteo is used by default (free, no API key required).
# Override URL only if using a custom proxy or provider.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Optional: only if using a paid/authenticated weather provider
# WEATHER_API_KEY=

# --- JWT Authentication ---
# Secret key for encoding JWT access tokens.
# Replace with a strong random string before running in production.
JWT_SECRET_KEY=

# --- SMTP Email Alerts ---
# Required for sending automated crop-health alert emails to the team.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# --- Team Alert Recipients ---
# Comma-separated list of team recipient email addresses.
ALERT_EMAILS=

# --- Alert Evaluation Thresholds (Optional Defaults) ---
# Minimum disease confidence to trigger high_confidence alert (default: 0.80)
ALERT_HIGH_CONFIDENCE=0.80
# Lookback window (in days) to check for repeated detection in same field (default: 30)
ALERT_REPEATED_DAYS=30

# --- Community Disease Clusters & Agri Authority ---
# Email address of District Agriculture Officer / Agronomist for cluster notifications
AGRI_ALERT_EMAIL=
# Minimum cases in coarse grid to trigger a community disease cluster alert (default: 5)
CLUSTER_CASE_THRESHOLD=5
# Lookback window in hours for community disease cluster detection (default: 24)
CLUSTER_TIME_WINDOW_HOURS=24
# Coarse geographic grid cell size in degrees (~0.1° ≈ 11 km; default: 0.1)
CLUSTER_GRID_SIZE=0.1

