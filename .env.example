# ============================================================
# SIH 26131 Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit this file to version control.
# ============================================================

# --- Gemini AI Chat ---
# Required for the /chat endpoint
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Weather API ---
# Open-Meteo is used by default (free, no key needed).
# To switch providers, override the URL and optionally set a key.
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_API_KEY=

# --- JWT Authentication ---
# Change this to a long random string in production!
JWT_SECRET_KEY=hackathon-super-secret-key-do-not-use-in-production

# --- SMTP Email Alerts ---
# Required for sending team alert emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_SENDER=your-email@gmail.com

# --- Team Alert Recipients ---
# Comma-separated list of team member emails
ALERT_EMAILS=team1@example.com,team2@example.com,team3@example.com

# --- Alert Thresholds ---
# Disease confidence >= this value triggers a "high_confidence" alert
ALERT_HIGH_CONFIDENCE=0.80
# Number of days to look back for "repeated detection" rule
ALERT_REPEATED_DAYS=30
